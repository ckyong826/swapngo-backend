# Production env — copy to `.env` ON THE SERVER and fill with REAL secrets.
# Never commit the real .env. Used by docker-compose.prod.yml (env_file).
#
# NOTE: DB_HOST / DB_PORT / KAFKA_BROKERS are OVERRIDDEN by compose to the
# container network names (postgres:5432, kafka:29092). Values here are ignored
# for those three, but keep them set so config validation passes.

# --- Database (Postgres runs in compose; DB_USER/PASSWORD/NAME seed the container) ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=swapngo
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_NAME=swapngo

# --- JWT / crypto secrets — generate strong random values ---
JWT_SECRET=CHANGE_ME_long_random_secret
KYC_ENCRYPTION_KEY=CHANGE_ME_32_byte_key
JWT_REFRESH_TIME=24h
JWT_ACCESS_TIME=168h

# --- Kafka (broker runs in compose) ---
KAFKA_BROKERS=kafka:29092

# --- Billplz (use live creds + URL in production) ---
BILLPLZ_API_URL=https://www.billplz.com/api/v3
BILLPLZ_API_KEY=CHANGE_ME
BILLPLZ_COLLECTION_ID=CHANGE_ME
BILLPLZ_CALLBACK_URL=https://your-domain.com/api/v1/public/deposit/webhook

# --- Blockchain RPC (required) ---
SUI_CHAIN_URL=https://fullnode.testnet.sui.io:443
SOL_CHAIN_URL=https://api.testnet.solana.com
EVM_CHAIN_URL=https://rpc.ankr.com/eth_sepolia

# --- Sui treasury / admin (REAL keys — required, keep secret) ---
SUI_TREASURY_ADDRESS=CHANGE_ME
SUI_TREASURY_PRIVATE_KEY=CHANGE_ME
MYRC_SUI_PACKAGE_ID=CHANGE_ME
MYRC_SUI_TREASURY_CAP_ID=CHANGE_ME
SUI_ADMIN_ADDRESS=CHANGE_ME
SUI_ADMIN_PRIVATE_KEY=CHANGE_ME
